{
  "name": "@itookit/vfsdriver-local",
  "version": "5.3.0",
  "description": "Transparent local-filesystem VFS backend \u2014 reads and writes go directly to real files on disk.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./node": {
        "import": {
          "types": "./dist/node.d.ts",
          "default": "./dist/node.js"
        },
        "require": {
          "types": "./dist/node.d.cts",
          "default": "./dist/node.cjs"
        }
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "itookit",
    "vfs",
    "localfs",
    "filesystem",
    "native",
    "storage",
    "node"
  ],
  "author": "lizlok@gmail.com",
  "license": "MIT",
  "dependencies": {
    "@itookit/vfs-core": "workspace:*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mushuanli/vfsdriver-local.git"
  },
  "bugs": {
    "url": "https://github.com/mushuanli/vfsdriver-local/issues"
  },
  "homepage": "https://github.com/mushuanli/vfsdriver-local#readme",
  "packageManager": "pnpm@10.20.0"
}
